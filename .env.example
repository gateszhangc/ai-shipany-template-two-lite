# app
NEXT_PUBLIC_APP_URL="https://galaxyai.homes"
NEXT_PUBLIC_APP_NAME="GalaxyAI"
NEXT_PUBLIC_APP_DESCRIPTION="GalaxyAI Inc. builds, acquires and scales iconic AI products to put the power of AI in everyone’s hands."
NEXT_PUBLIC_APP_LOGO="/galaxy/logo-mark-512.png"
NEXT_PUBLIC_APP_FAVICON="/galaxy/favicon-256.png"
NEXT_PUBLIC_APP_PREVIEW_IMAGE="/galaxy/og.jpg"

# theme and appearance
NEXT_PUBLIC_THEME="default"
NEXT_PUBLIC_APPEARANCE="light"

# locale — this project is intentionally English-only
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_LOCALE_DETECT_ENABLED="false"

# analytics (leave blank to disable)
GA_MEASUREMENT_ID=""

# database
# The deployment target uses an external PostgreSQL service. Fill this at runtime;
# never commit a real connection string.
DATABASE_PROVIDER="postgresql"
DATABASE_URL=""
DB_SINGLETON_ENABLED="false"
DB_MAX_CONNECTIONS="1"

# auth
# openssl rand -base64 32
AUTH_SECRET=""

# payment — Stripe is the only provider used by this site.
DEFAULT_PAYMENT_PROVIDER="stripe"
SELECT_PAYMENT_ENABLED="false"
STRIPE_ENABLED="true"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SIGNING_SECRET=""

# Google OAuth (set in the deployment environment, never in the repository)
GOOGLE_AUTH_ENABLED="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
