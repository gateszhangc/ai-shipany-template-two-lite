# app
NEXT_PUBLIC_APP_URL = "https://higgsfieldgenjutsu.lol"
NEXT_PUBLIC_APP_NAME = "Higgsfield Genjutsu"
NEXT_PUBLIC_APP_DESCRIPTION = "Create cinematic AI videos from text and images with Higgsfield Genjutsu."

# theme
NEXT_PUBLIC_THEME = "genjutsu"

# appearance
NEXT_PUBLIC_APPEARANCE = "dark"
NEXT_PUBLIC_DEFAULT_LOCALE = "en"
NEXT_PUBLIC_LOCALE_DETECT_ENABLED = "false"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
AUTH_URL = "https://higgsfieldgenjutsu.lol"

EMAIL_AUTH_ENABLED = "false"
GOOGLE_AUTH_ENABLED = "true"
GOOGLE_ONE_TAP_ENABLED = "false"
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
GITHUB_AUTH_ENABLED = "false"
GITHUB_CLIENT_ID = ""
GITHUB_CLIENT_SECRET = ""
