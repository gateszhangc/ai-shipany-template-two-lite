# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Your App Name"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# Waffo Pancake (leave blank until you are ready to run a test payment)
PANCAKE_ENABLED = "false"
DEFAULT_PAYMENT_PROVIDER = "pancake"
PANCAKE_ENVIRONMENT = "test"
PANCAKE_API_BASE_URL = "https://api.waffo.ai"
PANCAKE_MERCHANT_ID = ""
PANCAKE_STORE_ID = ""
PANCAKE_PRIVATE_KEY = ""
PANCAKE_WEBHOOK_PUBLIC_KEY = ""
PANCAKE_PRODUCT_IDS = '{}'
